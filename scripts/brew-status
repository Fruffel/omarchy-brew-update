#!/bin/bash
# Fetch tap metadata and write ~/.local/state/omarchy/brew-update.json.
set -euo pipefail

# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

include_casks=1
greedy=0
while (($# > 0)); do
  case "$1" in
  --no-casks) include_casks=0 ;;
  --casks) include_casks=1 ;;
  --greedy) greedy=1 ;;
  --help | -h)
    echo "Usage: brew-status [--casks|--no-casks] [--greedy]"
    exit 0
    ;;
  *)
    echo "Unknown option: $1" >&2
    exit 2
    ;;
  esac
  shift
done

if ! brew_ready; then
  fail_state "Homebrew is not installed"
  exit 1
fi

if ! brew_writable; then
  fail_state "Homebrew prefix is not writable. Run this plugin's setup script once."
  exit 1
fi

if ! try_lock; then
  # Another check or upgrade is already running; surface the current file.
  read_state
  exit 0
fi

merge_state "$(jq -nc '{checking: true, error: ""}')"

outdated_flags=(--json=v2)
if ((greedy == 1)); then
  outdated_flags+=(--greedy)
fi

update_error=""
if ! "$BREW" update --quiet >/dev/null 2>&1; then
  update_error="Could not fetch Homebrew updates"
fi

if ! raw="$("$BREW" outdated "${outdated_flags[@]}" 2>/dev/null)"; then
  fail_state "${update_error:-Could not list outdated Homebrew packages}"
  exit 1
fi

state="$(parse_outdated "$raw" "$include_casks")"
if [[ -n $update_error ]]; then
  state="$(jq -c --arg error "$update_error" '.ok = false | .error = $error' <<<"$state")"
fi

# Full installed list (local only): top-level formulae plus all casks.
# `brew leaves` names what nothing else depends on; tap formulae come out
# qualified (user/tap/name) while `brew list` uses short names, so match
# on the basename. Casks are always top-level by nature.
leaves_json="$(
  "$BREW" leaves 2>/dev/null \
    | jq -c -R -s 'split("\n") | map(select(length > 0) | split("/") | last)' || echo '[]'
)"
installed="$(
  "$BREW" list --versions 2>/dev/null | jq -c -R -s --argjson leaves "$leaves_json" '
    ($leaves | length == 0) as $noLeaves
    | split("\n") | map(select(length > 0) | split(" ")
      | {name: .[0], installed: (.[1:] | join(" ")), current: "", pinned: false, kind: "formula"}
      | select(.name != "" and ($noLeaves or (.name as $n | $leaves | index($n)))))' || echo '[]'
)"
if ((include_casks == 1)); then
  cask_installed="$(
    "$BREW" list --cask --versions 2>/dev/null | jq -c -R -s '
      split("\n") | map(select(length > 0) | split(" ")
      | {name: .[0], installed: (.[1:] | join(" ")), current: "", pinned: false, kind: "cask"}
      | select(.name != ""))' || echo '[]'
  )"
  installed="$(jq -nc --argjson a "$installed" --argjson b "$cask_installed" '$a + $b')"
fi
state="$(jq -c --argjson installed "$installed" '.installed = $installed' <<<"$state")"

write_state_file "$state"
printf '%s\n' "$state"
